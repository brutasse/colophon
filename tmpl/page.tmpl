<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>if (localStorage.theme) document.documentElement.dataset.theme = localStorage.theme;</script>
<title>{{.Title}} · {{.SiteTitle}}</title>
{{if .Favicon}}<link rel="icon" href="{{.Prefix}}{{.Favicon}}">{{end}}
{{if .SearchEngine}}<link rel="search" type="application/opensearchdescription+xml" title="{{.SiteTitle}}" href="{{.Prefix}}opensearch.xml">{{end}}
{{if .Search}}<link rel="stylesheet" href="{{.Prefix}}pagefind/pagefind-component-ui.css">{{end}}
<link rel="stylesheet" href="{{.Prefix}}{{asset "docs.css"}}">
<link rel="stylesheet" href="{{.Prefix}}{{asset "chroma.css"}}">
{{if .AccentCSS}}<style>{{.AccentCSS}}</style>{{end}}
{{if .Search}}{{/* Classic, not module: the bundle infers its own location from the URL this tag was
     loaded from, and a module script does not expose one. Loaded classic from a
     page-relative src, search resolves from any deploy path and at any page depth. */}}
<script defer src="{{.Prefix}}pagefind/pagefind-component-ui.js"></script>{{end}}
{{if .Search}}<script>
/* A search from the URL bar lands on any page with ?q=: the page answers it by
   opening the search modal, the same overlay the sidebar trigger opens, with the
   query pre-filled. Every search — that one, and the ones typed into the modal —
   is written to the URL, so a search is shareable as a link; closing the modal
   clears the query, the reset-on-close attribute doing the triggerSearch("").
   Deferred scripts finish before DOMContentLoaded, so the bundle is loaded by the
   time the handler runs. */
document.addEventListener("DOMContentLoaded", function () {
  var components = window.PagefindComponents;
  if (!components) return;
  var instance = components.getInstanceManager().getInstance("default");
  instance.on("search", function (term) {
    history.replaceState(history.state, "", location.pathname + (term ? "?q=" + encodeURIComponent(term) : ""));
  });
  var q = new URLSearchParams(location.search).get("q");
  var modal = document.querySelector("pagefind-modal");
  if (q && modal) {
    // The search runs while the input is not yet focused: the bundle's sync hook
    // skips the value write while the input is focused, and open() focuses it.
    instance.triggerSearch(q);
    modal.open();
  }
});
</script>{{end}}
{{if .Math}}<script>window.MathJax = {tex: {inlineMath: [["\\(", "\\)"]], displayMath: [["\\[", "\\]"]]}, options: {skipHtmlTags: ["script","noscript","style","textarea","pre","code"]}};</script>
<script defer src="{{.Prefix}}{{asset "vendor/tex-svg.js"}}"></script>{{end}}
{{if .Mermaid}}<script defer src="{{.Prefix}}{{asset "vendor/mermaid.min.js"}}"></script>{{end}}
{{if .Dev}}<script>(function(){
/* A WebSocket, not a stream: a stream would take one of the browser's six
   connections per origin for the life of the page. */
function watch(){
  var ws = new WebSocket((location.protocol == "https:" ? "wss://" : "ws://") +
    location.host + "/reload?path=" + encodeURIComponent(location.pathname));
  ws.onmessage = function () { location.reload(); };
  ws.onclose = function () { setTimeout(watch, 1000); }; // server may be restarting
}
watch();
})();</script>{{end}}
</head>
<body class="docs">
<div class="layout">
<nav class="sidebar" id="sidebar">
<a class="brand{{if .Logo}} brand-logo{{end}}{{if .LogoDark}} brand-themed{{end}}" href="{{.Prefix}}index.html">{{if .Logo}}<img src="{{.Prefix}}{{.Logo}}" alt="{{.SiteTitle}}">{{if .LogoDark}}<img class="brand-dark" src="{{.Prefix}}{{.LogoDark}}" alt="{{.SiteTitle}}">{{end}}{{else}}{{.SiteTitle}}{{end}}</a>
{{if .Search}}<div class="search-row"><pagefind-modal-trigger placeholder="Search docs"></pagefind-modal-trigger></div>{{end}}
<div class="navlist">{{.Sidebar}}</div>
<button class="theme-toggle" type="button" aria-label="Toggle color theme"></button>
</nav>
<div class="scrim" aria-hidden="true"></div>
<main>
<div class="crumbs"><button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="sidebar" aria-expanded="false">&#9776;</button><span class="crumbs-path">{{.Crumbs}}</span></div>
{{if .TOC}}<nav class="toc" aria-label="On this page">{{.TOC}}</nav>{{end}}
<article>{{.Content}}</article>
<nav class="prevnext">{{.PrevNext}}</nav>
<footer class="pagefoot">{{if .EditBase}}<a href="{{.EditBase}}/{{.EditPath}}">Edit this page</a>{{end}}{{if .Copyright}}<span>© {{.Copyright}}</span>{{end}}</footer>
</main>
</div>
{{if .Search}}<pagefind-modal reset-on-close></pagefind-modal>{{end}}
{{/* initialises mermaid, so it must stay behind the vendor tag above: deferred scripts run in document order. */}}
{{if .Mermaid}}<script defer src="{{.Prefix}}{{asset "mermaid-viewer.js"}}"></script>{{end}}
<script defer src="{{.Prefix}}{{asset "site.js"}}"></script>
{{if .TOC}}<script defer src="{{.Prefix}}{{asset "toc.js"}}"></script>{{end}}
</body>
</html>
